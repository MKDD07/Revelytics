{
  "name": "vite-react-ts-starter",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:d1": "wrangler pages dev -- npm run dev",
    "d1:push:remote": "wrangler d1 execute revelytics-db --remote --file=./schema.sql",
    "d1:push:local": "wrangler d1 execute revelytics-db --local --file=./schema.sql",
    "deploy:worker": "wrangler deploy",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.1.17",
    "gsap": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.0.8"
  }
}
